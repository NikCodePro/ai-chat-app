{
  "expo": {
    "name": "sankat seva",
    "slug": "ai-chat-app",
    "icon": "./assets/icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": [
      "sankatseva",
      "com.sankatseva",
      "com.googleusercontent.apps.985688017742-s8llh51e8657vstrg8amkpgtrb05qua5"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sankatseva",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Sankat Seva needs microphone access for AI voice calls."
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.sankatseva",
      "permissions": [
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Sankat Seva to access your microphone for voice calls."
        }
      ],
      "expo-notifications",
      "@livekit/react-native-expo-plugin"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "56ffecd4-e30e-40b5-a5d8-c33c88474cfe"
      }
    }
  }
}
